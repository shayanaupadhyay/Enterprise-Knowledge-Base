# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# Gemini (Google GenAI)
# https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================================
# ChromaDB
# Local dev: run a Chroma server and set CHROMA_URL, leave the
# Cloud vars blank.
# Production (Chroma Cloud): leave CHROMA_URL as-is and set
# CHROMA_API_KEY/TENANT/DATABASE from https://trychroma.com/ -
# their presence switches the app to CloudClient automatically.
# ============================================================
CHROMA_URL=http://localhost:8000
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=knowledge_base

# ============================================================
# Upload limits
# ============================================================
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# Chunking
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ============================================================
# Retrieval
# ============================================================
RETRIEVAL_TOP_K=5
