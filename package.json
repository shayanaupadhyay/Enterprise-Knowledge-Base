  "description": "Enterprise Knowledge Base Chatbot - Production-ready RAG backend built with NestJS, Gemini 2.5 Flash and ChromaDB",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
