    "@nestjs/serve-static": "^4.0.2",
    "chromadb": "^1.9.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
